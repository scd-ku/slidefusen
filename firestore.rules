rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isTeacher(roomId) {
      return signedIn()
        && roomDoc(roomId).data.ownerUid == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /notes/{noteId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.category == "未分類"
          && request.resource.data.likes == 0;

        allow update: if isTeacher(roomId)
          || (
            signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"])
            && request.resource.data.likes == resource.data.likes + 1
          );

        allow delete: if isTeacher(roomId);
      }
    }
  }
}
